{
  "schema_version": 1,
  "transcript_sha256": "5d3c792ed970932a082e717fef177924659aa3d4649999ff0df56c266815116e",
  "index": 4,
  "segments": [
    {
      "id": "s000992",
      "start_ms": 2432400,
      "end_ms": 2436599,
      "text": "нюансы. И здесь очень хороший вопрос,",
      "raw_indices": [
        1983
      ]
    },
    {
      "id": "s000993",
      "start_ms": 2434119,
      "end_ms": 2439720,
      "text": "мне кажется, в чате есть, пока мы в зале",
      "raw_indices": [
        1985
      ]
    },
    {
      "id": "s000994",
      "start_ms": 2436599,
      "end_ms": 2441839,
      "text": "ищем. А расскажи, а насколько ухудшился",
      "raw_indices": [
        1987
      ]
    },
    {
      "id": "s000995",
      "start_ms": 2439720,
      "end_ms": 2445319,
      "text": "DX разработчиков после того, как стало",
      "raw_indices": [
        1989
      ]
    },
    {
      "id": "s000996",
      "start_ms": 2441839,
      "end_ms": 2446680,
      "text": "необходимо поддерживать ПВА приложение?",
      "raw_indices": [
        1991
      ]
    },
    {
      "id": "s000997",
      "start_ms": 2445319,
      "end_ms": 2449359,
      "text": "Давайте начнём с того, что мы были",
      "raw_indices": [
        1993
      ]
    },
    {
      "id": "s000998",
      "start_ms": 2446680,
      "end_ms": 2452040,
      "text": "нативными разработчиками.",
      "raw_indices": [
        1995
      ]
    },
    {
      "id": "s000999",
      "start_ms": 2449359,
      "end_ms": 2453480,
      "text": "JS не все из нас даже нюхали. У меня был",
      "raw_indices": [
        1997
      ]
    },
    {
      "id": "s001000",
      "start_ms": 2452040,
      "end_ms": 2457040,
      "text": "какой-то опыт. Мы на реакции,",
      "raw_indices": [
        1999
      ]
    },
    {
      "id": "s001001",
      "start_ms": 2453480,
      "end_ms": 2458680,
      "text": "соответственно, продолжуху делали. А",
      "raw_indices": [
        2001
      ]
    },
    {
      "id": "s001002",
      "start_ms": 2457040,
      "end_ms": 2460200,
      "text": "расстроились всё очень сильно.",
      "raw_indices": [
        2003
      ]
    },
    {
      "id": "s001003",
      "start_ms": 2458680,
      "end_ms": 2463240,
      "text": "Переквалифицироваться пришлось",
      "raw_indices": [
        2005
      ]
    },
    {
      "id": "s001004",
      "start_ms": 2460200,
      "end_ms": 2464560,
      "text": "моментально. Практически мы с самого",
      "raw_indices": [
        2007
      ]
    },
    {
      "id": "s001005",
      "start_ms": 2463240,
      "end_ms": 2466720,
      "text": "начала даже не знали, к чему",
      "raw_indices": [
        2009
      ]
    },
    {
      "id": "s001006",
      "start_ms": 2464560,
      "end_ms": 2469560,
      "text": "поступиться. Изучали, сидели, курили",
      "raw_indices": [
        2011
      ]
    },
    {
      "id": "s001007",
      "start_ms": 2466720,
      "end_ms": 2472280,
      "text": "также. И всё. Если говорить о том, как",
      "raw_indices": [
        2013
      ]
    },
    {
      "id": "s001008",
      "start_ms": 2469560,
      "end_ms": 2474680,
      "text": "же всё-таки у нас всё изменилось, мы не",
      "raw_indices": [
        2015
      ]
    },
    {
      "id": "s001009",
      "start_ms": 2472280,
      "end_ms": 2476800,
      "text": "достигли стопроцентной схожести с",
      "raw_indices": [
        2017
      ]
    },
    {
      "id": "s001010",
      "start_ms": 2474680,
      "end_ms": 2479359,
      "text": "нативным приложением. Ну, процентов",
      "raw_indices": [
        2019
      ]
    },
    {
      "id": "s001011",
      "start_ms": 2476800,
      "end_ms": 2481680,
      "text": "где-то на 80 функционально закрыли. Если",
      "raw_indices": [
        2021
      ]
    },
    {
      "id": "s001012",
      "start_ms": 2479359,
      "end_ms": 2483800,
      "text": "говорить о том, что мы повторили то, что",
      "raw_indices": [
        2023
      ]
    },
    {
      "id": "s001013",
      "start_ms": 2481680,
      "end_ms": 2487040,
      "text": "необходимо было нашему заказчику, мы это",
      "raw_indices": [
        2025
      ]
    },
    {
      "id": "s001014",
      "start_ms": 2483800,
      "end_ms": 2489560,
      "text": "сделали. Но всё же, мм, ПВА приложение -",
      "raw_indices": [
        2027
      ]
    },
    {
      "id": "s001015",
      "start_ms": 2487040,
      "end_ms": 2492119,
      "text": "это какой-то консенсус между тем, что",
      "raw_indices": [
        2029
      ]
    },
    {
      "id": "s001016",
      "start_ms": 2489560,
      "end_ms": 2493880,
      "text": "может быть, и,",
      "raw_indices": [
        2031
      ]
    },
    {
      "id": "s001017",
      "start_ms": 2492119,
      "end_ms": 2495400,
      "text": "ну, как бы нам вариантов не оставили.",
      "raw_indices": [
        2033
      ]
    },
    {
      "id": "s001018",
      "start_ms": 2493880,
      "end_ms": 2497839,
      "text": "Банки все под санкциями, и что-то",
      "raw_indices": [
        2035
      ]
    },
    {
      "id": "s001019",
      "start_ms": 2495400,
      "end_ms": 2498760,
      "text": "пришлось придумывать. Я уже упустил",
      "raw_indices": [
        2037
      ]
    },
    {
      "id": "s001020",
      "start_ms": 2497839,
      "end_ms": 2501560,
      "text": "контекст.",
      "raw_indices": [
        2039
      ]
    },
    {
      "id": "s001021",
      "start_ms": 2498760,
      "end_ms": 2503040,
      "text": ">> А, всё. Насколько ухудшился DX? А есть",
      "raw_indices": [
        2041
      ]
    },
    {
      "id": "s001022",
      "start_ms": 2501560,
      "end_ms": 2506319,
      "text": "ли вопросы в зале? Вот я вижу, молодой",
      "raw_indices": [
        2043
      ]
    },
    {
      "id": "s001023",
      "start_ms": 2503040,
      "end_ms": 2506319,
      "text": "человек там.",
      "raw_indices": [
        2045
      ]
    },
    {
      "id": "s001024",
      "start_ms": 2507200,
      "end_ms": 2511079,
      "text": ">> Константин, спасибо за доклад, очень",
      "raw_indices": [
        2047
      ]
    },
    {
      "id": "s001025",
      "start_ms": 2509400,
      "end_ms": 2513440,
      "text": "интересно.",
      "raw_indices": [
        2049
      ]
    },
    {
      "id": "s001026",
      "start_ms": 2511079,
      "end_ms": 2517000,
      "text": "А я правильно понимаю, то есть если",
      "raw_indices": [
        2051
      ]
    },
    {
      "id": "s001027",
      "start_ms": 2513440,
      "end_ms": 2521800,
      "text": "завтра а разрешат Россельхозбанку",
      "raw_indices": [
        2053
      ]
    },
    {
      "id": "s001028",
      "start_ms": 2517000,
      "end_ms": 2523880,
      "text": "использовать ар, то вы прямо завтра ПВА",
      "raw_indices": [
        2055
      ]
    },
    {
      "id": "s001029",
      "start_ms": 2521800,
      "end_ms": 2525640,
      "text": "просто убиваете? У нас есть команды,",
      "raw_indices": [
        2057
      ]
    },
    {
      "id": "s001030",
      "start_ms": 2523880,
      "end_ms": 2527599,
      "text": "которые, естественно, занимаются",
      "raw_indices": [
        2059
      ]
    },
    {
      "id": "s001031",
      "start_ms": 2525640,
      "end_ms": 2530760,
      "text": "нативными приложениями. Они по 2 недели",
      "raw_indices": [
        2061
      ]
    },
    {
      "id": "s001032",
      "start_ms": 2527599,
      "end_ms": 2534440,
      "text": "в сторе живут, мы всеми пользуемся. А-э,",
      "raw_indices": [
        2063
      ]
    },
    {
      "id": "s001033",
      "start_ms": 2530760,
      "end_ms": 2536040,
      "text": "это делается, мы это не убили. Мно",
      "raw_indices": [
        2065
      ]
    },
    {
      "id": "s001034",
      "start_ms": 2534440,
      "end_ms": 2537640,
      "text": "труднее и труднее делать командам.",
      "raw_indices": [
        2067
      ]
    },
    {
      "id": "s001035",
      "start_ms": 2536040,
      "end_ms": 2539599,
      "text": "Труднее и труднее с тем же самым в стор",
      "raw_indices": [
        2069
      ]
    },
    {
      "id": "s001036",
      "start_ms": 2537640,
      "end_ms": 2542200,
      "text": "попадать. Режут много. Из двадцати",
      "raw_indices": [
        2071
      ]
    },
    {
      "id": "s001037",
      "start_ms": 2539599,
      "end_ms": 2544319,
      "text": "аккаунтов выживают два, грубо говоря.",
      "raw_indices": [
        2073
      ]
    },
    {
      "id": "s001038",
      "start_ms": 2542200,
      "end_ms": 2546359,
      "text": "Если поэтому, если да, то да.",
      "raw_indices": [
        2075
      ]
    },
    {
      "id": "s001039",
      "start_ms": 2544319,
      "end_ms": 2548559,
      "text": "Естественно, нативный опыт он лучше.",
      "raw_indices": [
        2077
      ]
    },
    {
      "id": "s001040",
      "start_ms": 2546359,
      "end_ms": 2550200,
      "text": "Здесь ничего не поделаешь. ПВА пока ещё",
      "raw_indices": [
        2079
      ]
    },
    {
      "id": "s001041",
      "start_ms": 2548559,
      "end_ms": 2551720,
      "text": "насе, естественно, далека от",
      "raw_indices": [
        2081
      ]
    },
    {
      "id": "s001042",
      "start_ms": 2550200,
      "end_ms": 2553640,
      "text": "совершенства, поэтому Да.",
      "raw_indices": [
        2083
      ]
    },
    {
      "id": "s001043",
      "start_ms": 2551720,
      "end_ms": 2556119,
      "text": ">> Да. То есть по сути Android",
      "raw_indices": [
        2085
      ]
    },
    {
      "id": "s001044",
      "start_ms": 2553640,
      "end_ms": 2558359,
      "text": "разработчиков никак не затронуло. Вот",
      "raw_indices": [
        2087
      ]
    },
    {
      "id": "s001045",
      "start_ms": 2556119,
      "end_ms": 2559160,
      "text": "они как работали с Андроидом, так и",
      "raw_indices": [
        2089
      ]
    },
    {
      "id": "s001046",
      "start_ms": 2558359,
      "end_ms": 2560400,
      "text": "работали.",
      "raw_indices": [
        2091
      ]
    },
    {
      "id": "s001047",
      "start_ms": 2559160,
      "end_ms": 2561960,
      "text": ">> Но мы но мы со своей стороны,",
      "raw_indices": [
        2093
      ]
    },
    {
      "id": "s001048",
      "start_ms": 2560400,
      "end_ms": 2563359,
      "text": "разрабатывая ПА, предусматриваем",
      "raw_indices": [
        2095
      ]
    },
    {
      "id": "s001049",
      "start_ms": 2561960,
      "end_ms": 2564960,
      "text": "предусматриваем её возможность работы на",
      "raw_indices": [
        2097
      ]
    },
    {
      "id": "s001050",
      "start_ms": 2563359,
      "end_ms": 2567359,
      "text": "две платформы. И сейчас ещё расширяем на",
      "raw_indices": [
        2099
      ]
    },
    {
      "id": "s001051",
      "start_ms": 2564960,
      "end_ms": 2569400,
      "text": "десктоп, в том числе. Как показывает",
      "raw_indices": [
        2101
      ]
    },
    {
      "id": "s001052",
      "start_ms": 2567359,
      "end_ms": 2571400,
      "text": "практика, странно. Тем не менее, у людей",
      "raw_indices": [
        2103
      ]
    },
    {
      "id": "s001053",
      "start_ms": 2569400,
      "end_ms": 2573160,
      "text": "на Андроиде возможность ПКшку стянуть",
      "raw_indices": [
        2105
      ]
    },
    {
      "id": "s001054",
      "start_ms": 2571400,
      "end_ms": 2574960,
      "text": "откуда угодно есть и установить, но",
      "raw_indices": [
        2107
      ]
    },
    {
      "id": "s001055",
      "start_ms": 2573160,
      "end_ms": 2575480,
      "text": "пвшку ставят. Это очень странно для",
      "raw_indices": [
        2109
      ]
    },
    {
      "id": "s001056",
      "start_ms": 2574960,
      "end_ms": 2578520,
      "text": "меня.",
      "raw_indices": [
        2111
      ]
    },
    {
      "id": "s001057",
      "start_ms": 2575480,
      "end_ms": 2581000,
      "text": ">> Вот. И у меня основной вопрос какой?",
      "raw_indices": [
        2113
      ]
    },
    {
      "id": "s001058",
      "start_ms": 2578520,
      "end_ms": 2583000,
      "text": "Есть ли у ПВА",
      "raw_indices": [
        2115
      ]
    },
    {
      "id": "s001059",
      "start_ms": 2581000,
      "end_ms": 2585559,
      "text": "какие-то объективные преимущества перед",
      "raw_indices": [
        2117
      ]
    },
    {
      "id": "s001060",
      "start_ms": 2583000,
      "end_ms": 2587960,
      "text": "нативкой? То есть есть ли какие-то",
      "raw_indices": [
        2119
      ]
    },
    {
      "id": "s001061",
      "start_ms": 2585559,
      "end_ms": 2592400,
      "text": "сценарии, где стоит использовать именно",
      "raw_indices": [
        2121
      ]
    },
    {
      "id": "s001062",
      "start_ms": 2587960,
      "end_ms": 2592400,
      "text": "ПВА, казиножки",
      "raw_indices": [
        2123
      ]
    },
    {
      "id": "s001063",
      "start_ms": 2592640,
      "end_ms": 2596559,
      "text": "и всякое околоплавающее. Там ни стора,",
      "raw_indices": [
        2125
      ]
    },
    {
      "id": "s001064",
      "start_ms": 2594880,
      "end_ms": 2599240,
      "text": "ни проверок, ничего не нужно. Что",
      "raw_indices": [
        2127
      ]
    },
    {
      "id": "s001065",
      "start_ms": 2596559,
      "end_ms": 2601160,
      "text": "хотите, то и творите. Это вот там, да,",
      "raw_indices": [
        2129
      ]
    },
    {
      "id": "s001066",
      "start_ms": 2599240,
      "end_ms": 2604640,
      "text": "оно там часто используются на самом деле",
      "raw_indices": [
        2131
      ]
    },
    {
      "id": "s001067",
      "start_ms": 2601160,
      "end_ms": 2607800,
      "text": "всяческие кликеры, крипто эти штуки. И в",
      "raw_indices": [
        2133
      ]
    },
    {
      "id": "s001068",
      "start_ms": 2604640,
      "end_ms": 2611480,
      "text": "общем, всё вот это вот запредельное",
      "raw_indices": [
        2135
      ]
    },
    {
      "id": "s001069",
      "start_ms": 2607800,
      "end_ms": 2613400,
      "text": "зазеркалье, оно там. Поэтому для кейсов,",
      "raw_indices": [
        2137
      ]
    },
    {
      "id": "s001070",
      "start_ms": 2611480,
      "end_ms": 2615200,
      "text": "которые касаются обычных пользователей и",
      "raw_indices": [
        2139
      ]
    },
    {
      "id": "s001071",
      "start_ms": 2613400,
      "end_ms": 2616760,
      "text": "обычных приложений, нет. Натив всё же",
      "raw_indices": [
        2141
      ]
    },
    {
      "id": "s001072",
      "start_ms": 2615200,
      "end_ms": 2619000,
      "text": "это натив, ничего не поделаешь.",
      "raw_indices": [
        2143
      ]
    },
    {
      "id": "s001073",
      "start_ms": 2616760,
      "end_ms": 2621319,
      "text": ">> Спасибо.",
      "raw_indices": [
        2145
      ]
    },
    {
      "id": "s001074",
      "start_ms": 2619000,
      "end_ms": 2623520,
      "text": ">> Да, да, хоть каждые 5 минут депломся.",
      "raw_indices": [
        2147
      ]
    },
    {
      "id": "s001075",
      "start_ms": 2621319,
      "end_ms": 2624880,
      "text": "Багу нашли, пофиксили и выкинули. Да не",
      "raw_indices": [
        2149
      ]
    },
    {
      "id": "s001076",
      "start_ms": 2623520,
      "end_ms": 2626760,
      "text": "надо ждать, пока какой-нибудь индусян",
      "raw_indices": [
        2151
      ]
    },
    {
      "id": "s001077",
      "start_ms": 2624880,
      "end_ms": 2628599,
      "text": "там откроет это у себя и посмотрит на",
      "raw_indices": [
        2153
      ]
    },
    {
      "id": "s001078",
      "start_ms": 2626760,
      "end_ms": 2631559,
      "text": "Эпле. Ну, печально иногда бывает. Долго",
      "raw_indices": [
        2155
      ]
    },
    {
      "id": "s001079",
      "start_ms": 2628599,
      "end_ms": 2633599,
      "text": "рассматривают прямо. Поэтому здесь, да,",
      "raw_indices": [
        2157
      ]
    },
    {
      "id": "s001080",
      "start_ms": 2631559,
      "end_ms": 2637160,
      "text": "плюсы есть. Но всё же эти плюсы не",
      "raw_indices": [
        2159
      ]
    },
    {
      "id": "s001081",
      "start_ms": 2633599,
      "end_ms": 2637160,
      "text": "перекрывают плюсов от Натива.",
      "raw_indices": [
        2161
      ]
    }
  ]
}